services:
  - type: web
    name: n8n-ffmpeg
    runtime: docker
    plan: free
    region: oregon                    # change if you prefer another region
    dockerfilePath: ./Dockerfile
    dockerContext: .
    healthCheckPath: /healthz
    envVars:
      # --- Core n8n settings ---
      - key: PORT
        value: "5678"
      - key: N8N_PORT
        value: "5678"
      - key: N8N_PROTOCOL
        value: https
      - key: NODE_ENV
        value: production
      - key: GENERIC_TIMEZONE
        value: Africa/Nairobi
      - key: TZ
        value: Africa/Nairobi

      # --- Important for webhooks & editor ---
      - key: WEBHOOK_URL
        value: https://n8n-ffmpeg.onrender.com   # ← change to your actual service URL after first deploy
      - key: N8N_HOST
        value: n8n-ffmpeg.onrender.com           # ← without https://
      - key: N8N_EDITOR_BASE_URL
        value: https://n8n-ffmpeg.onrender.com   # ← same as WEBHOOK_URL

      # --- Database (Supabase Postgres) ---
      - key: DB_TYPE
        value: postgresdb
      - key: DB_POSTGRESDB_HOST
        sync: false                              # set from Supabase (db.xxxxx.supabase.co or pooler host)
      - key: DB_POSTGRESDB_PORT
        sync: false                              # usually 5432 (direct) or 6543 (pooler)
      - key: DB_POSTGRESDB_USER
        sync: false                              # usually postgres (or postgres.project-ref for pooler)
      - key: DB_POSTGRESDB_PASSWORD
        sync: false                              # your Supabase database password
      - key: DB_POSTGRESDB_DATABASE
        sync: false                              # usually postgres
      - key: DB_POSTGRESDB_SSL_ENABLED
        value: "true"
      # Optional but often needed with Supabase:
      # - key: DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED
      #   value: "false"                         # only if you hit certificate issues

      # --- Cloudflare R2 (optional – better to use n8n Credentials, but useful for Execute Command / Code nodes) ---
      - key: R2_ACCESS_KEY_ID
        sync: false
      - key: R2_SECRET_ACCESS_KEY
        sync: false
      - key: R2_ENDPOINT
        value: https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
      - key: R2_BUCKET
        value: n8n-media

      # --- Supabase (API keys – still useful for nodes / Code) ---
      - key: SUPABASE_URL
        sync: false
      - key: SUPABASE_SERVICE_ROLE_KEY
        sync: false
      - key: SUPABASE_ANON_KEY
        sync: false

# No more databases: section – we are using external Supabase Postgres      - key: R2_BUCKET
        value: n8n-media               # change to your bucket name

      # --- Supabase ---
      - key: SUPABASE_URL
        sync: false
      - key: SUPABASE_SERVICE_ROLE_KEY
        sync: false
      - key: SUPABASE_ANON_KEY
        sync: false

databases:
  - name: n8n-db
    plan: free
    databaseName: n8n
    user: n8n

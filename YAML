services:
  - type: web
    name: n8n-ffmpeg
    runtime: docker
    plan: free
    dockerfilePath: ./Dockerfile
    dockerContext: .
    healthCheckPath: /healthz
    envVars:
      - key: PORT
        value: "5678"
      - key: N8N_PORT
        value: "5678"
      - key: N8N_PROTOCOL
        value: https
      - key: NODE_ENV
        value: production
      - key: GENERIC_TIMEZONE
        value: Africa/Nairobi   # change to your timezone
      - key: TZ
        value: Africa/Nairobi
      # Database vars will be auto-injected if you use the Blueprint + Postgres
      - key: DB_TYPE
        value: postgresdb
      - fromDatabase:
          name: n8n-db
          property: host
        key: DB_POSTGRESDB_HOST
      - fromDatabase:
          name: n8n-db
          property: port
        key: DB_POSTGRESDB_PORT
      - fromDatabase:
          name: n8n-db
          property: user
        key: DB_POSTGRESDB_USER
      - fromDatabase:
          name: n8n-db
          property: password
        key: DB_POSTGRESDB_PASSWORD
      - fromDatabase:
          name: n8n-db
          property: database
        key: DB_POSTGRESDB_DATABASE

databases:
  - name: n8n-db
    plan: free
    databaseName: n8n
    user: n8n
